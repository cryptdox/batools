database_url=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Login goes through the Crypt IAM service. Only the access code is required:
# the API base URL falls back to the hosted service, the client id is kept for
# reference only, and the Turnstile key is read on PROD builds alone (dev uses
# Cloudflare's public test key).
VITE_IAM_API_BASE_URL=https://crypt-iam-latest.onrender.com/api
VITE_IAM_CLIENT_ID=batools
VITE_IAM_CR_ACCESS_CODE=
VITE_TURNSTILE_SITE_KEY=

# Task Manager runs under one static identity (Bangla Tools has no Supabase
# Auth). Must match the owner id migration 012 wrote into the copied rows.
VITE_TM_USER_ID=00000000-0000-0000-0000-000000000111
