database_url=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Static login (currently active — see STATIC_LOGIN in src/lib/AuthContext.tsx).
# NOTE: VITE_ vars are compiled into the public JS bundle in plaintext, so this
# password is not a secret. It gates the UI only.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# IAM login — currently commented out in AuthContext/Login. Needed again when
# STATIC_LOGIN is set back to false.
VITE_IAM_API_BASE_URL=https://crypt-iam-latest.onrender.com/api
VITE_IAM_CLIENT_ID=batools
VITE_IAM_CR_ACCESS_CODE=
VITE_TURNSTILE_SITE_KEY=

# Task Manager runs under one static identity (Bangla Tools has no Supabase
# Auth). Must match the owner id migration 012 wrote into the copied rows.
VITE_TM_USER_ID=00000000-0000-0000-0000-000000000111
